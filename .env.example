# 银枢运行配置（复制为 .env 后生效；不填也能跑，默认全部走本机 Mock）
# 优先级：系统环境变量 > .env > 代码默认值

# ---------- 运行环境 ----------
# dev 开发（限流宽松、日志好看） / demo 演示（单进程、无限流） / prod 生产（多 worker、JSON 日志、限流）
YINSHU_ENV=demo

# ---------- 网络 ----------
YINSHU_HOST=127.0.0.1
YINSHU_PORT=8000
YINSHU_BANK_PORT=8010
YINSHU_BANK_BASE=http://127.0.0.1:8010
YINSHU_WORKERS=1

# ---------- 数据 ----------
# 改为绝对路径可把数据放挂载卷；默认 yinshu/data
# YINSHU_DATA_DIR=/var/lib/yinshu
YINSHU_SESSION_BACKEND=sqlite
YINSHU_SESSION_TTL=1800
YINSHU_CONFIRM_TTL=300

# ---------- 安全与限流 ----------
# 每分钟每来源请求数；0 = 不限流（演示用），prod 建议 120
YINSHU_RATE_LIMIT_RPM=0
YINSHU_MAX_TEXT_LEN=500
YINSHU_MAX_BODY_BYTES=65536
# 跨域白名单，逗号分隔；生产请写具体域名
YINSHU_CORS=*
# 接入鉴权：配了之后 /api/* 必须带 X-API-Key（网关级最小门禁）
YINSHU_API_KEYS=

# ---------- 身份（v1.1 新增）----------
# off=不校验（演示/测试，身份取 DEMO_USER_ID） / optional=带 token 则校验 / required=必须带
# 生产必须设 required；此时身份只认 Authorization: Bearer <JWT>，请求体里的 user_id 一律 422
YINSHU_AUTH_MODE=off
YINSHU_JWT_SECRET=change-me-in-prod
YINSHU_JWT_TTL=1800
YINSHU_USER_ID=1
# 兜底账户（仅核心系统不可用时使用；正常按主体解析真实账户）
YINSHU_ACCOUNT_ID=1

# ---------- 幂等（v1.1 新增）----------
# 显式 X-Idempotency-Key 的窗口（同一业务单号只处理一次）
YINSHU_IDEMPOTENCY_TTL=86400
# 未显式给 key 时按请求体派生的窗口（只覆盖网络重试，避免误伤"一天转两笔同额"）
YINSHU_IDEMPOTENCY_AUTO_TTL=600

# ---------- 审计链锚定（v1.1 新增）----------
# 留空 = 写本地 audit_anchors 表（只能防删除，防不住整表重写）
# 生产应指向行内存证 / WORM 对象锁存储，接口为 POST {seq, head, sig, ts} → {receipt_id}
YINSHU_ANCHOR_URL=
YINSHU_ANCHOR_TOKEN=
YINSHU_ANCHOR_KEY=change-me-in-prod
YINSHU_ANCHOR_INTERVAL=60

# ---------- 审计 PII 脱敏（v1.1 新增）----------
# 原文从不落库；这里只存 HMAC 摘要，用于"是不是同一条"的比对
YINSHU_PII_KEY=change-me-in-prod
YINSHU_PII_KEY_ID=local-v1
YINSHU_PII_RETENTION_DAYS=90

# ---------- 调试回吐 ----------
# 1=把 plan/decision/风险理由回吐给前端（演示用）；prod 默认 0，避免泄漏内部策略
YINSHU_DEBUG_ECHO=0

# ---------- 演示可复现（仅非 prod 生效）----------
# 权限引擎有"凌晨 0-6 点 +10 分"，不钉住小时的话同一句话白天 AUTO、凌晨 CONFIRM。
# 演示前设 14 即可复现 README 里的档位；只钉小时，不动日期
# YINSHU_FIXED_HOUR=14

# ---------- 可观测性 ----------
YINSHU_LOG_LEVEL=INFO
YINSHU_LOG_JSON=1
YINSHU_METRICS=1

# ---------- 可选：接入大模型做话术润色 ----------
# 本版本默认不启用，规则引擎已完整可用；接入方式见 README「扩展点」
YINSHU_LLM_KEY=
YINSHU_LLM_BASE=https://api.deepseek.com/v1
YINSHU_LLM_MODEL=deepseek-chat
